# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Needed for inquiries, estimates and `npm run seed:admin`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin account (created by `npm run seed:admin`, sign in at /admin/login) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# --- Cloudinary (images + video). SERVER ONLY — keep the secret private. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (e.g. 8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=Chattogram, Bangladesh
NEXT_PUBLIC_MAPS_EMBED_URL=

# --- Media shown on the home page ---
# Hero background video: the full Cloudinary video URL (mp4). Leave empty for the animated background only.
NEXT_PUBLIC_HERO_VIDEO_URL=
# 3D view in the "Walk through your space" section: an embeddable link (Sketchfab, Matterport, Kuula…)
# or a direct video URL (Cloudinary mp4).
NEXT_PUBLIC_3D_VIEW_URL=

# --- Payments (send-money numbers shown at checkout) ---
NEXT_PUBLIC_BKASH_NUMBER=01818173025
NEXT_PUBLIC_NAGAD_NUMBER=01818173025

# --- Social links (optional) ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
