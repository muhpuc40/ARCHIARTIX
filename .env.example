# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Needed for inquiries, estimates and `npm run seed:admin`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin account (created by `npm run seed:admin`, sign in at /admin/login) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# --- Cloudinary (images + video). SERVER ONLY — keep the secret private. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (e.g. 8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=Chattogram, Bangladesh
# Contact-page map. Leave empty for a Chattogram map, or paste the src="…" of Google Maps → Share → Embed a map to pin your studio.
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_MAPS_LINK=

# --- Developer page (/developer) — optional, shown only when filled ---
NEXT_PUBLIC_DEVELOPER_NAME=Minhaj
NEXT_PUBLIC_DEVELOPER_EMAIL=
NEXT_PUBLIC_DEVELOPER_PHONE=
NEXT_PUBLIC_DEVELOPER_WEBSITE=
NEXT_PUBLIC_DEVELOPER_GITHUB=
NEXT_PUBLIC_DEVELOPER_LINKEDIN=

# --- Media shown on the home page ---
# Hero images are managed in Admin → Hero images (stored in the database + Cloudinary).
# Walkthrough video (the "Video" tab next to 3D): Cloudinary mp4 URL or a YouTube link. Leave empty to hide the tab.
NEXT_PUBLIC_VIDEO_URL=
# 3D view in the "Walk through your space" section (shown by default). Use ONE of:
#   • your own model: put the file in public/3d/ and set  NEXT_PUBLIC_3D_VIEW_URL=/3d/room.glb
#   • a hosted .glb URL, or an embeddable link (Sketchfab, Matterport, Kuula…)
NEXT_PUBLIC_3D_VIEW_URL=

# --- Payments (send-money numbers shown at checkout) ---
NEXT_PUBLIC_BKASH_NUMBER=01818173025
NEXT_PUBLIC_NAGAD_NUMBER=01818173025

# --- Social links (optional) ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
